{
  "name": "flexidesa",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem Informasi Desa — rebuild modern (Next.js App Router).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:backfill-wilayah": "node scripts/wilayah/backfill-kode-wilayah.mjs",
    "db:sinkron-kepala-dusun": "node scripts/pemerintahan/sinkron-kepala-dusun.mjs",
    "platform:bootstrap": "node scripts/platform/bootstrap.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.8",
    "@mapbox/shp-write": "^0.4.3",
    "@tmcw/togeojson": "^7.1.4",
    "@whiskeysockets/baileys": "^6.7.24",
    "better-auth": "^1.7.10",
    "busboy": "^1.6.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "shpjs": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/busboy": "^1.5.5",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/shpjs": "^3.4.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
